<!--
  Configuración del servicio de accesibilidad mínimo. NO pide canRetrieveWindowContent (no lee la
  pantalla). Solo escucha un tipo de evento para poder habilitarse; no hace nada con él. Su único fin
  es que, estando habilitado, la app pueda captar el audio del altavoz durante una llamada (excepción
  de Google para servicios de accesibilidad). Lo prende y lo apaga el dueño del cel por adb.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/acc_descripcion" />
