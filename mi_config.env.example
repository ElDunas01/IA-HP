# Agente Isabella — configuración local. Copia este archivo como  mi_config.env  (NO se sube a git) y llénalo.
# Aquí NO van llaves: la llave de Gemini vive solo en el Worker (npx wrangler secret put GEMINI_API_KEY_AQ).

# URL de TU Worker (sale al final de `npx wrangler deploy`) + /token
WORKER_URL="https://agente-isabella-token.TU-SUBDOMINIO.workers.dev/token"

# Número de tu OTRO teléfono para las pruebas, y la lista de números permitidos (solo tuyos o de quien aceptó).
NUMERO_PRUEBA=""
NUMEROS_PERMITIDOS=""

# Serie de tu cel (sale en `adb devices`), solo si tienes más de uno conectado.
SERIE_CEL=""

# Minutos máximos por llamada (1 a 5) y modo de Isabella: servicios | isabella | flexible
TECHO_MIN=3
MODO="servicios"
